# LetzAiLegally Backend Environment Configuration

ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# AI Configuration
# Set your Google Gemini API key here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:5173,http://127.0.0.1:8443,https://letzz-ai-legally.vercel.app
